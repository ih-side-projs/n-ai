{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "components": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "depends_on": {
            "items": {
              "pattern": "^[a-z][a-z0-9-]*$",
              "type": "string"
            },
            "type": "array"
          },
          "name": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "type": "string"
          },
          "objective": {
            "maxLength": 500,
            "minLength": 10,
            "type": "string"
          }
        },
        "required": [
          "name",
          "objective",
          "depends_on"
        ],
        "type": "object"
      },
      "maxItems": 10,
      "minItems": 1,
      "type": "array"
    },
    "external_inputs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "name": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "type": "string"
          },
          "source": {
            "enum": [
              "user",
              "file",
              "api",
              "config",
              "env",
              "other"
            ],
            "type": "string"
          }
        },
        "required": [
          "name",
          "description",
          "source"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "external_outputs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "destination": {
            "enum": [
              "user",
              "file",
              "api",
              "db",
              "ui",
              "other"
            ],
            "type": "string"
          },
          "name": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "type": "string"
          }
        },
        "required": [
          "name",
          "description",
          "destination"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "shared_entities": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "minLength": 5,
            "type": "string"
          },
          "fields": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "description": {
                  "type": "string"
                },
                "name": {
                  "pattern": "^[a-z_][a-zA-Z0-9_]*$",
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "type"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "name": {
            "pattern": "^[A-Z][a-zA-Z0-9]*$",
            "type": "string"
          }
        },
        "required": [
          "name",
          "description"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "components",
    "shared_entities",
    "external_inputs",
    "external_outputs"
  ],
  "title": "DecomposeOutput",
  "type": "object"
}
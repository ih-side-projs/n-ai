{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "consumes": {
                "items": {
                  "pattern": "^[a-z][a-z0-9-]*$",
                  "type": "string"
                },
                "type": "array"
              },
              "description": {
                "type": "string"
              },
              "name": {
                "pattern": "^[a-z][a-z0-9-]*$",
                "type": "string"
              },
              "provides": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "description": {
                      "type": "string"
                    },
                    "name": {
                      "pattern": "^[a-z_][a-zA-Z0-9_]*$",
                      "type": "string"
                    },
                    "returns": {
                      "type": "string"
                    },
                    "signature": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "signature"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "name",
              "provides",
              "consumes"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "entities": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string"
              },
              "fields": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "description": {
                      "type": "string"
                    },
                    "name": {
                      "pattern": "^[a-z_][a-zA-Z0-9_]*$",
                      "type": "string"
                    },
                    "optional": {
                      "default": false,
                      "type": "boolean"
                    },
                    "type": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "type"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "name": {
                "pattern": "^[A-Z][a-zA-Z0-9]*$",
                "type": "string"
              }
            },
            "required": [
              "name",
              "fields"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "scenarios": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "pattern": "^S[0-9]+$",
                "type": "string"
              },
              "steps": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "call": {
                      "description": "Function name on the callee, no parentheses",
                      "type": "string"
                    },
                    "callee": {
                      "description": "Component id being called, or 'user'/'external'",
                      "type": "string"
                    },
                    "caller": {
                      "description": "Component id initiating the call, or 'user'/'external'",
                      "type": "string"
                    },
                    "fields": {
                      "description": "Field references passed/returned, e.g. User.id, Order.total",
                      "items": {
                        "pattern": "^[A-Z][a-zA-Z0-9]*\\.[a-z_][a-zA-Z0-9_]*$",
                        "type": "string"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "caller",
                    "callee",
                    "call",
                    "fields"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "title",
              "steps"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "entities",
        "components",
        "scenarios"
      ],
      "type": "object"
    }
  },
  "required": [
    "contract"
  ],
  "title": "InterfacesOutput",
  "type": "object"
}
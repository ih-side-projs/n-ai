{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "components": {
    "items": {
      "additionalProperties": false,
      "properties": {
        "consumes": {
          "items": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "type": "string"
          },
          "type": "array"
        },
        "description": {
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9-]*$",
          "type": "string"
        },
        "provides": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string"
              },
              "name": {
                "pattern": "^[a-z_][a-zA-Z0-9_]*$",
                "type": "string"
              },
              "returns": {
                "type": "string"
              },
              "signature": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "signature"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "provides",
        "consumes"
      ],
      "type": "object"
    },
    "type": "array"
  },
  "properties": {
    "entities": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "fields": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "description": {
                  "type": "string"
                },
                "name": {
                  "pattern": "^[a-z_][a-zA-Z0-9_]*$",
                  "type": "string"
                },
                "optional": {
                  "default": false,
                  "type": "boolean"
                },
                "type": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "type"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "name": {
            "pattern": "^[A-Z][a-zA-Z0-9]*$",
            "type": "string"
          }
        },
        "required": [
          "name",
          "fields"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "entities",
    "components",
    "scenarios"
  ],
  "scenarios": {
    "items": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^S[0-9]+$",
          "type": "string"
        },
        "steps": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "action": {
                "type": "string"
              },
              "actor": {
                "type": "string"
              },
              "expects": {
                "type": "string"
              },
              "provides": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "actor",
              "action",
              "expects"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "steps"
      ],
      "type": "object"
    },
    "type": "array"
  },
  "title": "Contract",
  "type": "object"
}
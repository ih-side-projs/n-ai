{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "guardrails": {
      "additionalProperties": false,
      "properties": {
        "accessibility_security": {
          "type": "string"
        },
        "core_workflows": {
          "type": "string"
        },
        "interface_type": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "non_goals": {
          "type": "string"
        },
        "runtime_deployment": {
          "type": "string"
        },
        "stack_libraries": {
          "type": "string"
        },
        "target_users": {
          "type": "string"
        },
        "testing_expectations": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "questions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^Q[0-9]+$",
            "type": "string"
          },
          "question": {
            "minLength": 10,
            "type": "string"
          },
          "why": {
            "minLength": 5,
            "type": "string"
          }
        },
        "required": [
          "id",
          "question",
          "why"
        ],
        "type": "object"
      },
      "maxItems": 5,
      "type": "array"
    },
    "readiness_summary": {
      "minLength": 10,
      "type": "string"
    },
    "ready_for_design": {
      "type": "boolean"
    },
    "refined_brief": {
      "minLength": 20,
      "type": "string"
    }
  },
  "required": [
    "ready_for_design",
    "questions",
    "readiness_summary",
    "refined_brief",
    "guardrails"
  ],
  "title": "IntakeOutput",
  "type": "object"
}